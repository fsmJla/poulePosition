{
  // Fichiers hors workspaces : configurations racine et tests E2E / garde-fous (exécutés sous Node).
  "extends": "./tsconfig.base.json",
  // DOM : code passé à page.evaluate(), exécuté dans le navigateur.
  "compilerOptions": { "lib": ["ES2023", "DOM"], "types": ["node"] },
  "include": ["*.config.ts", "outils/**/*.ts", "tests/e2e/**/*.ts", "tests/garde-fous/**/*.ts"]
}
