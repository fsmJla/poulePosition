{
  "name": "@poule-position/serveur",
  "private": true,
  "type": "module",
  "description": "Worker Cloudflare et Durable Objects (ADR-0004), issu du relais Wireless Fencing",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "dev:e2e": "wrangler dev --port 8791 --persist-to .wrangler/e2e --var POIVRE:poivre-e2e --var SECRET_INSTALLATION:installation-e2e --var SECRET_SESSION:session-e2e",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "typage": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@poule-position/domaine": "*",
    "@poule-position/protocole": "*",
    "worker-mailer": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "wrangler": "^4.157.0"
  }
}
