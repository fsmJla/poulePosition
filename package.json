{
  "name": "poule-position",
  "private": true,
  "type": "module",
  "description": "Organisation et suivi de compétitions d'escrime, local-first",
  "workspaces": [
    "paquets/domaine",
    "paquets/protocole",
    "serveur",
    "app"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names app,serveur --prefix-colors blue,magenta \"npm run dev -w app\" \"npm run dev -w serveur\"",
    "build": "npm run build -w app",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typage": "tsc -p tsconfig.json && npm run typage --workspaces --if-present",
    "test": "vitest run",
    "test:couverture": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:impact": "tsx outils/tests-impact.ts",
    "audit": "tsx outils/audit.ts",
    "test:charge": "node tests/charge/lancer.mjs",
    "creer-admin": "tsx outils/creer-admin.ts",
    "essai-email": "tsx outils/essai-email.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
